@page "/resources"

<PageTitle>Resources — Built with .NET MAUI</PageTitle>

<div class="container resources-page">
    <h1>Get started with .NET MAUI</h1>
    <p class="lede">
        Everything you need to build your own cross-platform app — official docs, learning paths,
        videos, and the community.
    </p>

    <div class="resource-groups">
        <section class="resource-group">
            <h2>Learn</h2>
            <ul class="resource-list">
                <li>
                    <a href="https://dot.net/maui" target="_blank" rel="noopener">
                        <strong>.NET MAUI website</strong>
                        <span>The official home of .NET Multi-platform App UI.</span>
                    </a>
                </li>
                <li>
                    <a href="https://learn.microsoft.com/dotnet/maui" target="_blank" rel="noopener">
                        <strong>.NET MAUI documentation</strong>
                        <span>Guides, API reference, and how-tos on Microsoft Learn.</span>
                    </a>
                </li>
                <li>
                    <a href="https://learn.microsoft.com/learn/paths/build-apps-with-dotnet-maui/" target="_blank" rel="noopener">
                        <strong>Build apps with .NET MAUI (learning path)</strong>
                        <span>A free, hands-on learning path that takes you from zero to a working app.</span>
                    </a>
                </li>
                <li>
                    <a href="https://dot.net/videos" target="_blank" rel="noopener">
                        <strong>.NET Beginner Series videos</strong>
                        <span>Short, friendly videos covering .NET and .NET MAUI fundamentals.</span>
                    </a>
                </li>
                <li>
                    <a href="https://www.youtube.com/playlist?list=PLdo4fOcmZ0oU6AgjUbyztrhnzGVFuN6ij" target="_blank" rel="noopener">
                        <strong>.NET MAUI Blazor Hybrid Beginner Series</strong>
                        <span>Build hybrid apps with Blazor and .NET MAUI, step by step.</span>
                    </a>
                </li>
            </ul>
        </section>

        <section class="resource-group">
            <h2>Build</h2>
            <ul class="resource-list">
                <li>
                    <a href="https://github.com/dotnet/maui" target="_blank" rel="noopener">
                        <strong>.NET MAUI on GitHub</strong>
                        <span>Source code, issue tracker, roadmap, and release notes.</span>
                    </a>
                </li>
                <li>
                    <a href="https://dotnet.microsoft.com/platform/customers/maui" target="_blank" rel="noopener">
                        <strong>Official customer showcases</strong>
                        <span>Microsoft's official collection of production .NET MAUI apps.</span>
                    </a>
                </li>
            </ul>
        </section>

        <section class="resource-group">
            <h2>Ship yours</h2>
            <p class="group-note">
                Built something with .NET MAUI? We'd love to feature it here.
            </p>
            <a href="submit" class="btn btn-primary">Submit your app →</a>
        </section>
    </div>
</div>
